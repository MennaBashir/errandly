# Copy this file to .env.local and set the right value for your setup.
#
# Backend base URL (NestJS server + global prefix /api + version /v1)
#   - Android emulator:  http://10.0.2.2:3000/api/v1   (10.0.2.2 = your PC's localhost)
#   - iOS simulator:     http://localhost:3000/api/v1
#   - Physical device:   http://<YOUR_PC_LAN_IP>:3000/api/v1  (e.g. http://192.168.1.5:3000/api/v1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
