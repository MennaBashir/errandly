{
  "expo": {
    "scheme": "errandly",
    "name": "errandly",
    "slug": "errandly",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9eda176a-f3f7-4232-88ad-08e69fe1b3d7"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mennabashir.errandly"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9eda176a-f3f7-4232-88ad-08e69fe1b3d7"
      }
    }
  }
}
